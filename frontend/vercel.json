{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/welcome-agents",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/welcome-agents.js": {
      "maxDuration": 280
    },
    "api/agent/[id].js": {
      "maxDuration": 60
    },
    "api/agent/[id]/full.js": {
      "maxDuration": 60
    }
  }
}
